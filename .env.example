# Copy to .env.local for local development. Never commit real values.
APP_URL=http://localhost:3012
APP_TIMEZONE=Asia/Jakarta
INITIAL_OWNER_EMAIL=gardaabdinegara@gmail.com
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_SPREADSHEET_ID=1_F6hZLKgpYdehD4BaWKLs1fG6E3T-gvBuJELvLLdN7s
# Production: paste the whole service account JSON as a secret environment value.
# Local development alone can read ./credentials.json when this value is blank.
GOOGLE_SERVICE_ACCOUNT_JSON=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Real writes require Redis, login, and explicit activation. Demo always works.
APP_WRITE_ENABLED=false
